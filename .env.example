# ==============================================================================
# ProofBattle Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Subsystem
# ------------------------------------------------------------------------------
# Bind host for Axum HTTP/WebSocket server (Default: 0.0.0.0; Safe to change in prod)
HOST=0.0.0.0
# Bind port for the HTTP/WebSocket server (Default: 3000; Safe to change in prod)
PORT=3000
# Tracing log level filter (Default: info,proof_battle=debug; Safe to change in prod)
RUST_LOG=info,proof_battle=debug

# ------------------------------------------------------------------------------
# 2. Database Subsystem (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Default: postgres://postgres:postgres@localhost:5432/proof_battle; Must configure in prod)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/proof_battle
# Maximum number of connections in the SQLx pool (Default: 20; Safe to change in prod)
DATABASE_MAX_CONNECTIONS=20

# ------------------------------------------------------------------------------
# 3. Session Store Subsystem
# ------------------------------------------------------------------------------
# Session store backend implementation: "memory" or "redis" (Default: memory; Safe to change in prod)
SESSION_STORE_BACKEND=memory
# Redis connection URL for distributed sessions/queues (Default: redis://127.0.0.1:6379; Safe to change in prod)
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 4. Lean Executor Subsystem
# ------------------------------------------------------------------------------
# Path to the Lean 4 project directory containing lakefile and Mathlib oleans (Default: ./battle; Safe to change in prod)
LEAN_PROJECT_PATH=./battle
# Maximum wall-clock execution timeout in seconds per proof verification (Default: 10; Safe to change in prod)
LEAN_TIMEOUT_SECS=10
# Maximum Lean heartbeat budget set in compiler options (Default: 200000; Safe to change in prod)
LEAN_MAX_HEARTBEATS=200000
# Worker pool capacity for match-critical submissions in SubmitLane (Default: 4; Safe to change in prod)
LEAN_SUBMIT_WORKERS=4
# Worker pool capacity for non-blocking live checks in CheckLane (Default: 2; Safe to change in prod)
LEAN_CHECK_WORKERS=2

# ------------------------------------------------------------------------------
# 5. Sandbox Subsystem
# ------------------------------------------------------------------------------
# Sandbox runner mode: "none", "docker", or "seccomp" (Default: none; MUST set to docker/seccomp in prod)
SANDBOX_MODE=none
# Memory limit in megabytes enforced on Lean verification processes (Default: 2048; Safe to change in prod)
SANDBOX_MEMORY_LIMIT_MB=2048
# CPU execution quota percentage per process (Default: 100; Safe to change in prod)
SANDBOX_CPU_QUOTA_PCT=100

# ------------------------------------------------------------------------------
# 6. Frontend / Public Subsystem
# ------------------------------------------------------------------------------
# WebSocket endpoint URL used by the client to connect to backend (Default: ws://localhost:3000/ws; Safe to change in prod)
PUBLIC_WS_URL=ws://localhost:3000/ws
# Base HTTP URL where the frontend web client is hosted (Default: http://localhost:5173; Safe to change in prod)
PUBLIC_SITE_URL=http://localhost:5173
